        "    avg_order_value=('revenue', 'mean'),",
        "    order_count=('order_id', 'count')",
        ").reset_index()"
      ],
      "language": "python",
      "highlightLine": 2,
      "annotationText": "Named aggregations: clean output names, multiple metrics in one pass, no postprocessing."
