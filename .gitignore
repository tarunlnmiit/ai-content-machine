# ============================================
# LFS-tracked critical artifacts (NOT ignored — see .gitattributes)
#   assets/slides/         (PDFs, HTMLs, PNGs, JPGs, fonts)
#   assets/social_posts/   (PNGs, HTMLs, fonts)
#   assets/carousels/      (HTMLs, PNGs)
#   content/worksheets/    (PDFs, HTMLs, fonts, svgs)
#   output/worksheets/     (PDFs)
# ============================================
.vercel
.env*

# Render outputs — large, regenerated by Remotion/HyperFrames, never commit to git
output/animations/**/*.mp4
assets/broll/

# ============================================
# Video / audio — NEVER track (any path, any size).
# GitHub hard-rejects files >100MB; raw recordings + renders are multi-GB.
# Extension rules are path-independent so they survive directory restructures
# (the v1/ move broke all the path-based rules above).
# ============================================
*.mp4
*.MP4
*.mov
*.MOV
*.m4v
*.avi
*.mkv
*.webm
*.m4a
*.mp3
*.wav
*.aac
*.flac

# Heavy media/asset dirs under the v1/ + v2/ restructure
v1/assets/audio/
v1/assets/video/
v1/assets/videos/
v1/assets/raw/
v1/assets/hyperframes/
v1/assets/reels_video/
v1/assets/stories/
v1/assets/stories_video/
v1/assets/broll/
v1/remotion/public/videos/
v1/remotion/public/broll/
v1/output/animations/**/*.mp4
v2/assets/
v2/remotion/public/videos/

# MCP config contains env-var references; never commit
.mcp.json

